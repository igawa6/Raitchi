+static void driver_directory(char *out, size_t capacity, const char *path, const char *label) {
+    if (!path || path[0] != '/') FATAL("custom GPU driver %s must be an absolute directory\n", label);
+    size_t length = strlen(path);
+    if (length + 2 > capacity) FATAL("custom GPU driver %s path is too long\n", label);
+    memcpy(out, path, length);
+    if (out[length - 1] != '/') out[length++] = '/';
+    out[length] = 0;  // AdrenoTools concatenates the directory and library names
+    struct stat st;
+    if (stat(out, &st) != 0 || !S_ISDIR(st.st_mode))
+        FATAL("custom GPU driver %s directory is unavailable: %s\n", label, out);
+}
+
+static void require_driver_file(const char *directory, const char *name) {
+    char path[8192];
+    int length = snprintf(path, sizeof path, "%s%s", directory, name);
+    struct stat st;
+    if (length < 0 || (size_t)length >= sizeof path || stat(path, &st) != 0 ||
+        !S_ISREG(st.st_mode) || access(path, R_OK) != 0)
+        FATAL("requested custom GPU driver file is unavailable: %s%s\n", directory, name);
+}
+
+static bool load_custom_driver(void) {
+    const char *directory = getenv("LARECOMP_GPU_DRIVER_DIR");
+    const char *library = getenv("LARECOMP_GPU_DRIVER_LIB");
+    const char *hooks = getenv("LARECOMP_GPU_DRIVER_HOOKS");
+    if (!directory && !library && !hooks) return false;  // stock loader remains the default
+    if (!directory || !*directory || !library || !*library || strchr(library, '/') ||
+        !strcmp(library, ".") || !strcmp(library, ".."))
+        FATAL("custom GPU driver requires LARECOMP_GPU_DRIVER_DIR and a library basename in LARECOMP_GPU_DRIVER_LIB\n");
+    char driver_dir[4096], hook_dir[4096], executable[4096];
+    driver_directory(driver_dir, sizeof driver_dir, directory, "driver");
+    if (!hooks) {
+        if (!plat_exe_path(executable, sizeof executable) || strstr(executable, "!/"))
+            FATAL("custom GPU hooks need extracted native libraries (legacyPackaging)\n");
+        char *slash = strrchr(executable, '/');
+        if (!slash) FATAL("cannot locate the custom GPU hooks beside libmain.so\n");
+        slash[1] = 0;
+        hooks = executable;
+    }
+    driver_directory(hook_dir, sizeof hook_dir, hooks, "hooks");
+    require_driver_file(driver_dir, library);
+    require_driver_file(hook_dir, "libmain_hook.so");
+    require_driver_file(hook_dir, "libhook_impl.so");
+    // API30 has memfd support: no temporary patch directory, turbo, file redirects or GPU mapping flags.
+    custom_driver_library = adrenotools_open_libvulkan(RTLD_NOW | RTLD_LOCAL, ADRENOTOOLS_DRIVER_CUSTOM,
+        NULL, hook_dir, driver_dir, library, NULL, NULL);
+    PFN_vkGetInstanceProcAddr loader = custom_driver_library ?
+        (PFN_vkGetInstanceProcAddr)dlsym(custom_driver_library, "vkGetInstanceProcAddr") : NULL;
+    if (!loader) FATAL("requested custom GPU driver failed to load via AdrenoTools: %s%s\n", driver_dir, library);
+    volkInitializeCustom(loader);
+    if (!vkCreateInstance) FATAL("requested custom GPU driver has no vkCreateInstance\n");
+    custom_driver_on = true;
+    LOG("[vk] requested custom GPU driver: %s%s (hooks %s)\n", driver_dir, library, hook_dir);
+    return true;
+}
