+// Android ARM64 host layer, adapted from the MIT-licensed Let's Go Recomp Linux layer and LAS Recomp Android.
+// Upstream copyrights/licenses remain in LICENSE and LICENSE-LASRecomp. No game code is included here.
+#define _GNU_SOURCE
+#include <SDL3/SDL.h>
+#include <android/log.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <ftw.h>
+#include <pthread.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/ucontext.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+#include <unwind.h>
+
+#include "../platform.h"
+#include "../paths.h"
+
+#if !defined(__ANDROID__) || !defined(__aarch64__)
+#error "This reference host layer requires Android ARM64"
+#endif
+#ifndef MAP_FIXED_NOREPLACE
+#define MAP_FIXED_NOREPLACE 0x100000
+#endif
+
+static uint64_t reserved_lo, reserved_hi;
+bool plat_reserve_guest(uint64_t lo, uint64_t hi) {
+    if (hi <= lo || reserved_hi) { errno = EINVAL; return false; }
+    void *p = mmap((void *)(uintptr_t)lo, hi - lo, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED_NOREPLACE, -1, 0);
+    if (p == MAP_FAILED) return false;
+    if (p != (void *)(uintptr_t)lo) { munmap(p, hi - lo); errno = EEXIST; return false; }
+    reserved_lo = lo, reserved_hi = hi;
+    return true;
+}
+bool plat_reset_guest(uint64_t lo, uint64_t hi) {
+    // Never replace memory outside the window this host layer successfully claimed.
+    if (hi <= lo || lo != reserved_lo || hi != reserved_hi) { errno = EINVAL; return false; }
+    return mmap((void *)(uintptr_t)lo, hi - lo, PROT_READ | PROT_WRITE,
+                MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE | MAP_FIXED, -1, 0) == (void *)(uintptr_t)lo;
+}
+void plat_commit(uint64_t addr, uint64_t size) { (void)addr; (void)size; }
+bool plat_watch_writes(uint64_t watch_lo) { (void)watch_lo; return false; }
+int plat_written(uint64_t addr, uint64_t size, uint64_t *out, int max) {
+    (void)addr; (void)size; (void)out; (void)max;
+    return -1;  // Match the upstream Linux baseline: callers fall back to untracked memory.
+}
+int plat_protect(uint64_t addr, uint64_t size, int prot) {
+    int p = prot == PLAT_PROT_NONE ? PROT_NONE : prot == PLAT_PROT_READ ? PROT_READ : PROT_READ | PROT_WRITE;
+    return mprotect((void *)(uintptr_t)addr, size, p);
+}
+
+uint64_t plat_now_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+void plat_sleep_until_ns(uint64_t t) {
+    struct timespec ts = {.tv_sec = (time_t)(t / 1000000000ull), .tv_nsec = (long)(t % 1000000000ull)};
+    while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL) == EINTR) {}
+}
+void plat_thread_realtime(uint64_t period_ns) { (void)period_ns; }  // Retain Android's normal scheduler policy.
+
+static char g_log_path[1200];
+void plat_init(void) {
+    const char *dir = getenv("LARECOMP_DATA_ROOT");
+    if (!dir || !*dir) dir = SDL_GetAndroidExternalStoragePath();
+    if (!dir || !*dir) dir = SDL_GetAndroidInternalStoragePath();
+    if (!dir || !*dir) return;
+    char parent[1024];
+    snprintf(parent, sizeof parent, "%s", dir);
+    for (char *p = parent + 1; *p; p++)
+        if (*p == '/') { *p = 0; mkdir(parent, 0755); *p = '/'; }
+    mkdir(parent, 0755);
+    snprintf(g_log_path, sizeof g_log_path, "%s/lasrecomp.log", parent);
+    char previous[1220];
+    snprintf(previous, sizeof previous, "%s.prev", g_log_path);
+    rename(g_log_path, previous);
+    int fd = open(g_log_path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+    if (fd < 0) { g_log_path[0] = 0; return; }
+    if (fd != STDERR_FILENO) dup2(fd, STDERR_FILENO);
+    if (fd != STDOUT_FILENO) dup2(fd, STDOUT_FILENO);
+    if (fd != STDERR_FILENO && fd != STDOUT_FILENO) close(fd);
+    setvbuf(stderr, NULL, _IOLBF, 0);
+    __android_log_print(ANDROID_LOG_INFO, "LetsGoRecomp", "Native reference log: %s", g_log_path);
+}
+bool plat_exe_path(char *buf, size_t size) {
+    Dl_info di = {0};
+    if (!buf || !size || !dladdr((void *)plat_exe_path, &di) || !di.dli_fname) return false;
+    int n = snprintf(buf, size, "%s", di.dli_fname);
+    return n >= 0 && (size_t)n < size;
+}
+void plat_exec(char *const argv[]) { (void)argv; errno = ENOTSUP; }
+void plat_terminate(void) { _exit(0); }
+
+const char *plat_symbol(uint64_t pc, uint64_t *offset) {
+    Dl_info di = {0};
+    if (!dladdr((void *)(uintptr_t)pc, &di) || !di.dli_sname) return NULL;
+    if (offset) *offset = pc - (uint64_t)(uintptr_t)di.dli_saddr;
+    return di.dli_sname;
+}
+const char *rt_host_fn_name(uint64_t pc, uint64_t *offset);
+typedef struct { uintptr_t pcs[64]; unsigned n; } Frames;
+static _Unwind_Reason_Code unwind_frame(struct _Unwind_Context *context, void *arg) {
+    Frames *frames = arg;
+    uintptr_t pc = _Unwind_GetIP(context);
+    if (pc && frames->n < 64) frames->pcs[frames->n++] = pc;
+    return frames->n < 64 ? _URC_NO_REASON : _URC_END_OF_STACK;
+}
+void plat_print_backtrace(void) {
+    Frames frames = {0};
+    _Unwind_Backtrace(unwind_frame, &frames);
+    Dl_info self = {0};
+    dladdr((void *)plat_print_backtrace, &self);
+    for (unsigned i = 0; i < frames.n; i++) {
+        uint64_t pc = frames.pcs[i], offset = 0;
+        Dl_info di = {0};
+        dladdr((void *)(uintptr_t)pc, &di);
+        const char *name = plat_symbol(pc, &offset);
+        if (!name && di.dli_fbase && di.dli_fbase == self.dli_fbase) name = rt_host_fn_name(pc, &offset);
+        const char *module = di.dli_fname ? strrchr(di.dli_fname, '/') : NULL;
+        module = module ? module + 1 : di.dli_fname ? di.dli_fname : "?";
+        fprintf(stderr, "  #%u %016llx %s+%llx (%s+%llx)\n", i, (unsigned long long)pc,
+                name ? name : "?", (unsigned long long)offset, module,
+                (unsigned long long)(pc - (uint64_t)(uintptr_t)di.dli_fbase));
+    }
+}
+void plat_fatal_notice(void) {
+    fflush(stderr);
+    char text[1400];
+    snprintf(text, sizeof text, RT_APP_NAME " stopped. Details: %s", g_log_path[0] ? g_log_path : "native stderr");
+    __android_log_write(ANDROID_LOG_ERROR, "LetsGoRecomp", text);
+    SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, RT_APP_NAME, text, NULL);
+}
+static void crash_handler(int sig, siginfo_t *info, void *context) {
+    ucontext_t *uc = context;
+    uint64_t fault = (uint64_t)(uintptr_t)info->si_addr;
+    uint64_t pc = uc->uc_mcontext.pc, lr = uc->uc_mcontext.regs[30];
+    if (rt_fault_watch(fault, pc)) return;
+    static volatile sig_atomic_t handling;
+    if (handling) _exit(128 + sig);
+    handling = 1;
+    char what[32];
+    snprintf(what, sizeof what, "signal %d", sig);
+    rt_fault_report(what, fault, pc, lr);
+}
+void plat_crash_handler_install(void) {
+    stack_t alternate = {.ss_sp = malloc(1 << 20), .ss_size = 1 << 20};
+    if (alternate.ss_sp && sigaltstack(&alternate, NULL) != 0) free(alternate.ss_sp);
+    struct sigaction action = {0};
+    sigemptyset(&action.sa_mask);
+    action.sa_sigaction = crash_handler;
+    action.sa_flags = SA_SIGINFO | SA_ONSTACK;
+    const int signals[] = {SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT};
+    for (unsigned i = 0; i < sizeof signals / sizeof *signals; i++) sigaction(signals[i], &action, NULL);
+}
+
+extern char **environ;
+PlatProc plat_spawn(const char *const argv[], const char *log_path, bool append_log) {
+    if (!argv || !argv[0]) { errno = EINVAL; return 0; }
+    posix_spawn_file_actions_t files;
+    posix_spawn_file_actions_init(&files);
+    posix_spawn_file_actions_addopen(&files, STDOUT_FILENO, log_path ? log_path : "/dev/null",
+        O_WRONLY | O_CREAT | (append_log ? O_APPEND : O_TRUNC), 0600);
+    posix_spawn_file_actions_adddup2(&files, STDOUT_FILENO, STDERR_FILENO);
+    posix_spawnattr_t attributes;
+    posix_spawnattr_init(&attributes);
+    posix_spawnattr_setflags(&attributes, POSIX_SPAWN_SETPGROUP);
+    posix_spawnattr_setpgroup(&attributes, 0);
+    pid_t child;
+    int status = posix_spawn(&child, argv[0], &files, &attributes, (char *const *)argv, environ);
+    posix_spawnattr_destroy(&attributes);
+    posix_spawn_file_actions_destroy(&files);
+    if (status) errno = status;
+    return status ? 0 : (PlatProc)child;
+}
+int plat_proc_wait(PlatProc child, bool block) {
+    if (child <= 0) return 255;
+    int status;
+    pid_t result;
+    do result = waitpid((pid_t)child, &status, block ? 0 : WNOHANG); while (result < 0 && errno == EINTR);
+    return !result ? -1 : result < 0 || !WIFEXITED(status) ? 255 : WEXITSTATUS(status);
+}
+void plat_proc_kill(PlatProc child) {
+    if (child <= 0) return;
+    kill(-(pid_t)child, SIGKILL);
+    while (waitpid((pid_t)child, NULL, 0) < 0 && errno == EINTR) {}
+}
+static int remove_entry(const char *path, const struct stat *st, int type, struct FTW *walk) {
+    (void)st; (void)type; (void)walk;
+    return remove(path);
+}
+bool plat_remove_tree(const char *dir) { return nftw(dir, remove_entry, 16, FTW_DEPTH | FTW_PHYS) == 0; }
